{
  // Cloudflare hosting: an assets-only Worker serving the Vite build.
  // Deploy with `npm run deploy` (builds, then `wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandfirst-media",
  "compatibility_date": "2026-09-23",

  "assets": {
    "directory": "./dist",
    // Every public page is a prerendered file (scripts/prerender.mjs), served
    // at its clean URL: /about from about.html, /brands/room16 from
    // brands/room16.html (html_handling's default, auto-trailing-slash). Any
    // other path gets 404.html with a real 404 status. It used to get
    // index.html with a 200, which told search engines every mistyped URL was
    // a duplicate of the homepage.
    "not_found_handling": "404-page"
  },

  // Both hostnames attach as Workers Custom Domains, which create and manage
  // their own DNS records and certificates. Deploying replaces whatever DNS
  // record each hostname had before (it was a Hostinger parked page).
  "routes": [
    { "pattern": "brandfirstmedia.com", "custom_domain": true },
    { "pattern": "www.brandfirstmedia.com", "custom_domain": true }
  ]
}
